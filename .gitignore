.venv/
*.egg-info/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.mypy_cache/
node_modules/
*.tsbuildinfo
web/dist/
web/public/data/
web/playwright-report/
web/test-results/

/build/
/dist/
/site/
sites/**/build/
sites/**/site/
.romwiki/
.local/

# Old generated record pages remain ignored in existing local checkouts.
sites/games/*/wiki/pokemon/
sites/games/*/wiki/encounters/
sites/games/*/wiki/trainers/
sites/games/*/wiki/locations/
sites/games/*/wiki/moves/
sites/games/*/wiki/abilities/
sites/games/*/wiki/items/
sites/games/*/wiki/changes/
sites/games/*/wiki/types/

# Normalized public datasets and comparison sidecars are generated locally.
sites/games/*/wiki/data/

# Snapshot archives are published as `snapshots` release assets; only the
# manifest that pins their checksums is tracked.
sites/generated-wiki/*.tar.gz
sites/frontend-snapshot/*.tar.gz

# User-supplied game images and related emulator data must remain local.
*.nds
*.3ds
*.cia
*.gba
*.gbc
*.gb
*.sav
*.dsv
*.srm
*.state

# ROM hack patches and console keys must remain local; the README's legal
# notice already promises these are never tracked.
*.ips
*.bps
*.ups
*.xdelta
*.pat
prod.keys
title.keys
