.venv/
*.egg-info/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.mypy_cache/
node_modules/
*.tsbuildinfo
web/dist/
web/public/data/
web/playwright-report/
web/test-results/

/build/
/dist/
.romwiki/
.local/

# Normalized public datasets and comparison sidecars are generated locally.
sites/games/*/wiki/data/

# The frontend snapshot archive is a `snapshots` release asset; only the
# manifest that pins its checksums is tracked.
sites/frontend-snapshot/*.tar.gz

# User-supplied game images and related emulator data must remain local.
*.nds
*.3ds
*.cia
*.gba
*.gbc
*.gb
*.sav
*.dsv
*.srm
*.state

# ROM hack patches and console keys must remain local; the README's legal
# notice already promises these are never tracked.
*.ips
*.bps
*.ups
*.xdelta
*.pat
prod.keys
title.keys
